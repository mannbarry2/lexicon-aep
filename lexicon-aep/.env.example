# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# PostgreSQL connection (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Firebase (client-side, exposed to browser - safe with proper rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side, KEEP SECRET)
# Single-line JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# SendGrid for email
SENDGRID_API_KEY=

# Express session signing key (generate a long random string)
SESSION_SECRET=

# Optional: port override (default 5000)
PORT=5000

NODE_ENV=development
